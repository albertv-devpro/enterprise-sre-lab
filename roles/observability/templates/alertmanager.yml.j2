global:
  resolve_timeout: 5m

route:
  group_by:
    - alertname
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h
  receiver: sre-api-webhook

receivers:
  - name: sre-api-webhook
    webhook_configs:
      - url: http://192.168.56.1:5000/api/v1/webhooks/alertmanager
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials_file: /etc/alertmanager/api-token
