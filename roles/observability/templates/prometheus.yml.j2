global:
  scrape_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - localhost:9093

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: enterprise-nodes
    static_configs:
      - targets:
{% for host in groups['all'] | sort %}
          - "{{ hostvars[host]['ansible_host'] | default(host) }}:9100"
{% endfor %}
